   "source": [
    "num = int (input(\"enter a num:\"))\n",
    "rev = 0\n",
    "while num > 0:\n",
    "    r = num % 10\n",
    "    rev = rev * 10 + r\n",
    "    num = num // 10\n",
    "print (rev)"
   ]
